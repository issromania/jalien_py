#!/usr/bin/env bash

ARG="${1}"
shift

[[ "${ARG}" == "ci-tests" ]] && IS_CI="1"

SCRIPT_DIR="$(realpath --canonicalize-existing "$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )")"

mapfile -t test_dirlist < <(find "${SCRIPT_DIR}" -type d -name "*.test" | sort)  # one entry per line: paths with spaces

# not run in CI (ci-tests, as in alidist xjalienfs.sh): CI has only a token, given by JALIEN_TOKEN_{CERT,KEY}, and no user certificate;
# these tests are about the credentials of the user (default token files, token creation/destroy with the user certificate)
CI_SKIP_TESTS=("002_env_tokens.test" "012_token_init.test")

FAILED_TESTS="0"

for t in "${test_dirlist[@]}"; do
    TEST_NAME="$(basename "${t}")"
    if [[ -n "${IS_CI}" && " ${CI_SKIP_TESTS[*]} " == *" ${TEST_NAME} "* ]]; then
        echo -e "Skipping test : ${TEST_NAME} (not run in CI)\n"
        continue
    fi

    echo "Running test : ${TEST_NAME} ... "
    pushd "${t}" &> /dev/null
    ./test.sh
    EXITCODE="${?}"
    if [[ ${EXITCODE} == "0" ]]; then
        echo -e "OK\n"
    else
        (( FAILED_TESTS++ ))
        echo -e "Failed test!!! Exitcode == ${EXITCODE}\n"
        [[ -z "${IS_CI}" ]] && break;
    fi
    popd &> /dev/null
done

exit "${FAILED_TESTS}"
