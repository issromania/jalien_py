#!/usr/bin/env bash

REPO="$(git rev-parse --show-toplevel)"

if [[ -e "${REPO}/.commit_in_progress" ]]; then
    pushd "${REPO}" &> /dev/null
    rm -f "${REPO}/.commit_in_progress"
    "${REPO}/update_version"
    git add alienpy/version.py  # only the version file: other changes of the work tree are not part of the commit
    git commit --amend -C HEAD --no-verify
    popd &> /dev/null
fi

exit 0
